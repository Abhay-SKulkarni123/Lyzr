# Architect 2.0 Environment Variables
# Copy this file to .env and fill in your values

# Next.js
NEXT_PUBLIC_APP_URL=http://localhost:3000

# GitHub Integration (optional - for real features)
GITHUB_TOKEN=
GITHUB_USERNAME=

# Authentication (optional)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Deployment targets (optional)
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
NETLIFY_SITE_ID=
NETLIFY_AUTH_TOKEN=

# API Keys for LLM services (optional for mock mode)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=